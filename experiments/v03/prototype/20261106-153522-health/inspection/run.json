  "review": {
    "approved": false,
    "issues": [
      "index.cjs: `Number.parseInt(process.env.PORT,10)||3000` accepts malformed values like '3000abc' (parses to 3000) and coerces '0' or negative values to 3000 rather than rejecting/validating them.",
      "app.cjs: non-GET requests to /health fall through to 404 'not_found', conflating method-not-allowed with not-found; FR1 only specifies GET but 405 would be more correct on /health.",
      "app.cjs: absolute-form request targets (proxy-style 'http://host/health') won't match '/health' because only '?query' is stripped, not the authority/scheme.",
      "index.cjs: no 'error' listener on the server, so EADDRINUSE or other listen failures crash unhandled instead of logging and exiting cleanly.",
      "test/health.test.cjs: after() unconditionally calls server.close(); if before() rejected, closing a non-listening server is unguarded (harmless but could hide setup failures)."
    ]
  },
