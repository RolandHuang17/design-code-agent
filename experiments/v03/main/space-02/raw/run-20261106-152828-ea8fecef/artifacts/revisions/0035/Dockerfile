# Space Fractions gateway image.
#
# Node.js 22+ single-process gateway hosting the game/question/user/admin
# service entrypoints (compromise C4 in architecture-decisions.md). PostgreSQL
# is the system of record and must be reachable before the container starts
# (Compose `depends_on: service_healthy`); Redis/RabbitMQ/Elasticsearch degrade
# gracefully when absent.
#
# The lockfile consumed by `npm ci` is generated by the host during the pinned
# install check (never committed by hand). Keep this file in sync with
# compose.yaml's `gateway.build` block.

# ---- build stage: run scripts/build (real source check) and prune dev deps --
FROM node:22-alpine AS build
WORKDIR /app

COPY package.json ./
COPY package-lock.json ./

# Pin dependency versions (never "latest"). A temporary missing lockfile is
# tolerated only until the host generates one.
RUN npm ci

COPY . .
RUN npm run build

# Prune devDependencies so the runtime image carries only production needs.
RUN npm prune --omit=dev

# ---- runtime stage -----------------------------------------------------------
FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app

# Non-root runtime user.
RUN addgroup -S spacefractions && adduser -S spacefractions -G spacefractions

COPY --from=build --chown=spacefractions:spacefractions /app ./

USER spacefractions

EXPOSE 3000

HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=5 \
  CMD node -e "require('http').get('http://localhost:3000/health',r=>{process.exit(r.statusCode===200?0:1)}).on('error',()=>process.exit(1))"

CMD ["node", "gateway/index.js"]