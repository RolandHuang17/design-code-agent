# Library borrowing gateway configuration
# Copy to .env (git-ignored) and adjust for your environment.

# PostgreSQL connection (used by src/server.js)
PGHOST=postgres
PGPORT=5432
PGUSER=library
PGPASSWORD=library
PGDATABASE=library

# Port the gateway listens on inside the container
PORT=3000

# Public origin for browser redirects (unused by this local demo; placeholder only)
PUBLIC_ORIGIN=http://localhost:3000