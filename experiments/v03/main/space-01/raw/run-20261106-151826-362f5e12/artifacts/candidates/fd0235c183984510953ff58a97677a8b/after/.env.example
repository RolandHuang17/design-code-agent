# Space Fractions — environment template (placeholders only; no real credentials).
# Copy to .env and adjust for your environment. Never commit real secrets.

# ---- Public / origin plumbing -------------------------------------------------
# Public browser origin (e.g. http://localhost:3000). The test runtime remaps ports,
# so rely on this variable rather than a fixed host port.
PUBLIC_ORIGIN=http://localhost:3000

# ---- OIDC / Keycloak -----------------------------------------------------------
# Public issuer base origin used by the browser for the authorization endpoint.
OIDC_PUBLIC_ORIGIN=http://localhost:8080
OIDC_ISSUER=http://localhost:8080/realms/space-fractions
# JWKS reached over the Compose-internal network (http allowed locally-only).
OIDC_JWKS_URI=http://keycloak:8080/realms/space-fractions/protocol/openid-connect/certs
# Public browser client id (PKCE S256). Local-only demo client.
OIDC_CLIENT_ID=space-fractions-client
# Audience carried by issued tokens.
OIDC_AUDIENCE=space-fractions

# ---- PostgreSQL (owns all game state) ------------------------------------------
PGHOST=postgres
PGPORT=5432
PGDATABASE=spacefractions
PGUSER=spacefractions
PGPASSWORD=spacefractions

# ---- Redis (cache-only game state) ---------------------------------------------
REDIS_URL=redis://redis:6379

# ---- RabbitMQ (score events) ---------------------------------------------------
AMQP_URL=amqp://spacefractions:spacefractions@rabbitmq:5672

# ---- Elasticsearch (question search) -------------------------------------------
ELASTICSEARCH_URL=http://elasticsearch:9200

# ---- Observability --------------------------------------------------------------
# Port the Prometheus metrics endpoint listens on (per service).
METRICS_PORT=9090

# ---- Application tuning ---------------------------------------------------------
LOG_LEVEL=info
# Bounded timeout (ms) for downstream HTTP calls.
HTTP_TIMEOUT_MS=5000