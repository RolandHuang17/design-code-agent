# Copy to .env and adjust for local development. All values are placeholders;
# never commit real credentials or secrets.

# Listening port (container port 3000 for the compose gateway service).
PORT=3000

# PostgreSQL connection string used by the gateway (matches the compose
# `postgres` service DNS name and credentials).
DATABASE_URL=postgresql://library:library@postgres:5432/library

# Browser-facing origin used for redirects and client-facing URL construction.
PUBLIC_ORIGIN=http://localhost:3000

# Identity-provider public URLs. Forwarded as gateway configuration only; no
# OAuth flow is implemented (reader IDs are caller-provided demonstration
# inputs, not authenticated identities).
OIDC_ISSUER=
OIDC_PUBLIC_ORIGIN=