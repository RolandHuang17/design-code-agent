# Space Fractions Environment Configuration
# Copy this file to .env and fill in values

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=spacefractions
PGUSER=spacefractions
PGPASSWORD=change_me_in_production

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://localhost:5672

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# OIDC / Keycloak
OIDC_ISSUER=http://localhost:8080/realms/space-fractions
OIDC_CLIENT_ID=space-fractions-client
OIDC_CLIENT_SECRET=replace-with-client-secret
OIDC_AUDIENCE=account

# Gateway
PORT=3000

# Keycloak Admin (for realm import only)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin