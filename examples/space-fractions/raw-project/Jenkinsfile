// Space Fractions — CI/CD pipeline (declarative).
//
// Stages:
//   1. Checkout & dependency install (npm ci — lockfile required)
//   2. Static/syntax checks (node --check over all sources)
//   3. Unit tests (node:test, no external infra required)
//   4. Build verification (runtime smoke: entrypoints parse + health not asserted)
//   5. Integration tests (require Compose infrastructure; run conditionally)
//   6. Container image build (optional push to an OCI registry)
//   7. Kubernetes deployment (optional, gated on BRANCH_NAME == main)
//
// NOTE: the package.json "build" script is a placeholder echo. Per project
// policy the build step must actually verify sources; this pipeline performs
// that verification directly here (syntax check + entrypoint smoke) so that
// CI never trusts an echo string. See architecture-decisions.md.
//
// Secret references (Jenkins credentials, never hardcoded):
//   - 'docker-hub-credentials'  (username/password)
//   - 'kubeconfig'              (secret file)

pipeline {
  agent any

  environment {
    NODE_VERSION = '22'
    DOCKER_REGISTRY = '' // e.g. 'registry.example.com/space-fractions'; empty => skip push
    IMAGE_TAG = "${env.BUILD_NUMBER ?: 'local'}"
  }

  options {
    timestamps()
    timeout(time: 60, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '5'))
    disableConcurrentBuilds()
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Install Dependencies') {
      steps {
        sh 'node --version'
        sh 'npm --version'
        sh 'npm ci'
      }
    }

    stage('Static & Syntax Checks') {
      steps {
        script {
          // --check parse/validate every JS source file without executing it.
          def sources = sh(
            script: "find shared gateway services -name '*.js' -not -path '*/node_modules/*' | sort",
            returnStdout: true
          ).trim().split('\n')
          sources.each { f ->
            sh "node --check ${f}"
          }
        }
      }
    }

    stage('Unit Tests') {
      steps {
        // Node's built-in test runner; no Postgres/Redis/AMQP/ES required.
        sh 'npm test'
      }
    }

    stage('Build Verification') {
      steps {
        // Verify every service entrypoint loads (syntax + top-level requires).
        // We use `--check` here too, since starting a server would block and
        // require infrastructure. This is a real source check, not an echo.
        script {
          def entrypoints = [
            'gateway/src/index.js',
            'services/game-service/src/index.js',
            'services/question-service/src/index.js',
            'services/user-service/src/index.js',
            'services/admin-service/src/index.js'
          ]
          entrypoints.each { ep ->
            sh "node --check ${ep}"
          }
        }
      }
    }

    stage('Integration Tests') {
      when {
        expression {
          // Integration tests need backing services; opt-in via parameter.
          return params.RUN_INTEGRATION == true
        }
      }
      steps {
        sh 'docker compose up -d postgres redis rabbitmq elasticsearch keycloak'
        sh 'npm run test:integration'
      }
      post {
        always {
          sh 'docker compose down -v || true'
        }
      }
    }

    stage('Build Container Images') {
      steps {
        script {
          def services = [
            'gateway',
            'services/game-service',
            'services/question-service',
            'services/user-service',
            'services/admin-service'
          ]
          services.each { svc ->
            def name = svc.replace('services/', '').replace('gateway', 'gateway')
            def dockerfile = "${svc}/Dockerfile"
            def tag = "${name}:${IMAGE_TAG}"
            sh "docker build -f ${dockerfile} -t ${tag} ."
          }
        }
      }
    }

    stage('Push Images') {
      when {
        expression {
          return env.DOCKER_REGISTRY?.trim() &&
                 env.BRANCH_NAME == 'main'
        }
      }
      steps {
        withCredentials([usernamePassword(
          credentialsId: 'docker-hub-credentials',
          usernameVariable: 'DOCKER_USER',
          passwordVariable: 'DOCKER_PASS'
        )]) {
          sh 'echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin'
        }
        script {
          def services = ['gateway', 'game-service', 'question-service', 'user-service', 'admin-service']
          services.each { name ->
            def local = "${name}:${IMAGE_TAG}"
            def remote = "${env.DOCKER_REGISTRY}/${name}:${IMAGE_TAG}"
            sh "docker tag ${local} ${remote}"
            sh "docker push ${remote}"
          }
        }
      }
    }

    stage('Deploy to Kubernetes') {
      when {
        expression { return env.BRANCH_NAME == 'main' && params.DEPLOY == true }
      }
      steps {
        withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
          sh '''
            export KUBECONFIG="$KUBECONFIG"
            kubectl apply -f k8s/namespace.yaml
            kubectl apply -f k8s/configmap.yaml
            kubectl apply -k k8s/ || kubectl apply -f k8s/
          '''
        }
      }
    }
  }

  parameters {
    booleanParam(name: 'RUN_INTEGRATION', defaultValue: false,
                 description: 'Run integration tests against Compose infrastructure')
    booleanParam(name: 'DEPLOY', defaultValue: false,
                 description: 'Deploy to Kubernetes on main (requires kubeconfig credentials)')
  }

  post {
    always {
      junit allowEmptyResults: true, testResults: 'reports/junit/*.xml'
      archiveArtifacts allowEmptyArchive: true, artifacts: 'reports/**/*'
    }
    failure {
      echo 'Pipeline failed. Check the failing stage logs above.'
    }
  }
}